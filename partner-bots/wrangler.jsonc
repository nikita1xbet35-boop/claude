{
  "name": "partner-bots",
  "main": "worker.js",
  "compatibility_date": "2026-05-19",

  // Не стирать переменные, заведённые в панели Cloudflare.
  //
  // wrangler считает plain-text переменные декларативными: без блока "vars"
  // здесь деплой удалил бы всё, что заведено в панели типом Text. На соседнем
  // воркере это уже стоило разбирательства — AUTH_*-переменные исчезали после
  // каждого деплоя, оставаясь при этом видимыми в интерфейсе.
  //
  // Токены ботов всё равно должны быть Secret, а не Text: Text показывает
  // значение открытым текстом в панели.
  "keep_vars": true,

  // Один тик в сутки. Реминдер по ТЗ §3.5 уходит через 6 дней и ровно один
  // раз, так что чаще проверять нечего — окно всё равно суточное.
  //
  // 09:00 UTC выбрано как разумная середина для гео от Западной Африки до
  // Узбекистана: попадает в рабочий день везде, кроме крайних часовых поясов.
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
