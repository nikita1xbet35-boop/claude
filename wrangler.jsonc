{
  "name": "claude",
  "main": "worker.js",
  "compatibility_date": "2026-05-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // ПАУЗА (см. supabase/migrations/041_pause_system.sql): это, а не pg_cron,
  // реальный планировщик — scheduledHandler() в worker.js бьёт по всем
  // edge-функциям HTTP-запросом напрямую по этим 5 расписаниям, минуя Postgres
  // целиком. 041 останавливала cron.job, которого в этой цепочке НЕТ —
  // не помогала. Восстановить: вернуть закомментированный массив ниже.
  //   "crons": ["*/2 * * * *", "*/3 * * * *", "*/15 * * * *", "0 7 * * *", "*/7 * * * *"]
  "triggers": {
    "crons": []
  }
}
